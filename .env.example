# Discord Bot Configuration
# Token can be set here or placed into token.txt
DISCORD_TOKEN=

# Discord Server Filtering (Optional, comma-separated)
# Leave empty to allow the bot on any server it joins
PERMITTED_SERVER_IDS=

# Channel Filtering (Optional, comma-separated)
# Leave empty to allow commands in all channels
PERMITTED_CHANNEL_IDS=

# User IDs for Global Admins and Teachers (comma-separated)
# Server admins can always manage games in their own servers.
# Users in ADMIN_IDS can manage games everywhere and run $shutdown.
ADMIN_IDS=
TEACHER_IDS=
